VORTEX_ENV=production
VORTEX_DATA_DIR=/data
VORTEX_HTTP_PORT=8000

# Required on the first production startup when the database has no users.
VORTEX_BOOTSTRAP_ADMIN_USERNAME=admin
VORTEX_BOOTSTRAP_ADMIN_PASSWORD=change-me-with-a-long-random-password
VORTEX_BOOTSTRAP_ADMIN_LANGUAGE=it
VORTEX_BOOTSTRAP_DEMO_USERS=false

QDRANT_URL=http://qdrant:6333

VORTEX_SESSION_COOKIE_NAME=vortex_session
VORTEX_SESSION_COOKIE_SECURE=true
VORTEX_SESSION_COOKIE_SAMESITE=lax
VORTEX_SESSION_MAX_AGE_SECONDS=28800

VORTEX_LOGIN_RATE_WINDOW_SECONDS=900
VORTEX_LOGIN_RATE_MAX_ATTEMPTS=8
VORTEX_LOGIN_RATE_LOCK_SECONDS=900

VORTEX_MAX_UPLOAD_FILES=20
VORTEX_MAX_UPLOAD_SIZE_BYTES=104857600
# Upload extension and MIME allowlists use the defaults in app/config.py,
# including DXF and DWG. Override only when narrowing accepted formats.
VORTEX_MAX_PDF_PAGES_RENDERED=40

VORTEX_TEXT_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VORTEX_CLIP_TEXT_MODEL=Qdrant/clip-ViT-B-32-text
VORTEX_CLIP_IMAGE_MODEL=Qdrant/clip-ViT-B-32-vision
